{
  "name": "bluepainter",
  "displayName": "BluePainter",
  "description": "Visual canvas ↔ code sync with AST preservation and Designer's Receipts for React/TSX",
  "version": "0.2.0",
  "publisher": "bluepainter",
  "private": false,
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/kevinhorek/bluepainter-studio.git"
  },
  "bugs": {
    "url": "https://github.com/kevinhorek/bluepainter-studio/issues"
  },
  "homepage": "https://bluepainter-studio.vercel.app",
  "qna": "https://github.com/kevinhorek/bluepainter-studio/discussions",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "react",
    "tsx",
    "jsx",
    "design",
    "figma",
    "canvas",
    "visual editor",
    "ast",
    "design-system",
    "accessibility",
    "wcag",
    "design-lint",
    "component",
    "ui"
  ],
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/badge/demo-live-blue",
      "href": "https://bluepainter-studio.vercel.app",
      "description": "Live Demo"
    }
  ],
  "activationEvents": [
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact",
    "onCommand:bluepainter.openPanel",
    "onCommand:bluepainter.openCanvas",
    "onCommand:bluepainter.syncFromFile",
    "onCommand:bluepainter.writeToFile"
  ],
  "main": "./extension.js",
  "dependencies": {
    "@babel/generator": "^7.29.7",
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@babel/types": "^7.28.0",
    "recast": "^0.23.12"
  },
  "contributes": {
    "commands": [
      {
        "command": "bluepainter.openPanel",
        "title": "BluePainter: Open Sidebar Panel"
      },
      {
        "command": "bluepainter.openCanvas",
        "title": "BluePainter: Open Canvas Editor"
      },
      {
        "command": "bluepainter.syncFromFile",
        "title": "BluePainter: Sync Canvas from File"
      },
      {
        "command": "bluepainter.writeToFile",
        "title": "BluePainter: Write Canvas to File"
      }
    ],
    "configuration": {
      "title": "BluePainter",
      "properties": {
        "bluepainter.demoUrl": {
          "type": "string",
          "default": "https://bluepainter-studio.vercel.app/#/app",
          "description": "URL for the BluePainter web validation demo."
        },
        "bluepainter.spacingGrid": {
          "type": "number",
          "default": 8,
          "description": "Designer Receipts spacing grid (px)."
        },
        "bluepainter.radiusGrid": {
          "type": "number",
          "default": 4,
          "description": "Designer Receipts border-radius grid (px)."
        },
        "bluepainter.minContrastRatio": {
          "type": "number",
          "default": 4.5,
          "description": "Minimum WCAG contrast ratio for button receipts."
        },
        "bluepainter.maxFeatureCount": {
          "type": "number",
          "default": 5,
          "description": "Maximum feature list items before clutter receipt fires."
        },
        "bluepainter.weakCtaWords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["submit", "click here", "send", "button", "ok", "enter"],
          "description": "Weak CTA words that trigger conversion receipts."
        },
        "bluepainter.suggestedCta": {
          "type": "string",
          "default": "Start free trial",
          "description": "Suggested CTA copy for receipt fixes."
        },
        "bluepainter.contrastFixColor": {
          "type": "string",
          "default": "#1e40af",
          "description": "Button background color applied by contrast fix."
        },
        "bluepainter.enableDesignSystemDetection": {
          "type": "boolean",
          "default": true,
          "description": "Detect design systems and monorepos to show helpful tips."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bluepainter",
          "title": "BluePainter",
          "icon": "$(paintcan)"
        }
      ]
    },
    "views": {
      "bluepainter": [
        {
          "id": "bluepainter.panel",
          "name": "BluePainter"
        }
      ]
    }
  },
  "scripts": {
    "package": "vsce package --no-dependencies",
    "publish:marketplace": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
