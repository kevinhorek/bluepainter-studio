---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DEMO_APP } from '../../lib/constants';
---

<BaseLayout
  title="Free BluePainter Tools — Contrast, Receipts & TSX ids"
  description="Free browser tools from BluePainter: a WCAG contrast checker, a Designer's Receipts grader, and a TSX id analyzer. No install, no account."
>
  <section class="section">
    <div class="page-head" data-reveal>
      <p class="eyebrow">Free tools</p>
      <h1>Kick the tyres in ten seconds.</h1>
      <p class="lead">
        Three small tools built on the same receipt logic as the BluePainter Studio. They run in your browser —
        nothing you paste is uploaded. Add your email if you want the suggested fixes.
      </p>
    </div>
    <div class="grid-3 stack-lg">
      <a class="card card-link" href="/tools/contrast-checker" data-reveal>
        <span class="badge">A11y</span>
        <h3>Contrast checker</h3>
        <p class="muted">WCAG ratio for any button colour, with the fix BluePainter would suggest.</p>
        <span class="go">Open tool →</span>
      </a>
      <a class="card card-link" href="/tools/receipt-grader" data-reveal="80">
        <span class="badge">Policy</span>
        <h3>Receipt grader</h3>
        <p class="muted">Score spacing, contrast, CTA copy, radius and clutter in one pass.</p>
        <span class="go">Open tool →</span>
      </a>
      <a class="card card-link" href="/tools/tsx-id-analyzer" data-reveal="160">
        <span class="badge">Sync</span>
        <h3>TSX id analyzer</h3>
        <p class="muted">Paste a component, see exactly which elements the canvas can map.</p>
        <span class="go">Open tool →</span>
      </a>
      <a class="card" href="/tools/roi-calculator" style="color:inherit">
        <span class="badge">ROI</span>
        <h3>Design review ROI calculator</h3>
        <p class="muted">Estimate the yearly time and cost saved by catching design issues before merge.</p>
      </a>
    </div>
    <p class="muted stack-lg" data-reveal>
      Want the full loop — canvas, code and receipts together? <a href={DEMO_APP}>Open the live studio →</a>
    </p>
  </section>
</BaseLayout>
