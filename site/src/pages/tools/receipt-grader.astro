---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DEMO_APP, WAITLIST_URL } from '../../lib/constants';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: "BluePainter Receipt Grader",
  applicationCategory: 'DesignApplication',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
};
---

<BaseLayout
  title="Free Receipt Grader — BluePainter"
  description="Grade spacing, contrast, CTA copy, radius, and clutter with Designer's Receipts policy. Free tool."
  jsonLd={jsonLd}
>
  <section class="section">
    <p class="eyebrow">Free tool</p>
    <h1>Receipt grader</h1>
    <p class="lead">Score a component against BluePainter's default team policy — spacing, contrast, CTA copy, radius and clutter. Runs in your browser.</p>
    <div class="tool-panel" data-reveal>
      <div>
        <label for="padding">Padding (px)</label>
        <input id="padding" type="number" value="32" />
        <label for="bg">Button background</label>
        <input id="bg" value="#93c5fd" />
        <label for="cta">CTA text</label>
        <input id="cta" value="Submit" />
        <label for="radius">Border radius (px)</label>
        <input id="radius" type="number" value="12" />
        <label for="features">Feature count</label>
        <input id="features" type="number" value="6" />
        <button type="button" class="btn btn-primary" id="run" style="margin-top:16px;width:100%">Grade</button>
        <div class="email-gate" id="gate" hidden>
          <p class="muted">Enter your email to see the suggested fixes and join the newsletter.</p>
          <label for="email">Email</label>
          <input id="email" type="email" autocomplete="email" placeholder="you@company.com" />
          <span class="hp" aria-hidden="true">
            <label for="website">Website (leave this empty)</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </span>
          <button type="button" class="btn btn-ghost" id="unlock" style="margin-top:8px;width:100%">Show suggested fixes</button>
          <p class="form-status muted" hidden></p>
        </div>
      </div>
      <div class="result-box" id="result" aria-live="polite"><p class="muted">Score appears here.</p></div>
    </div>
    <p class="stack-lg"><a href="/tools">← All tools</a> · <a href={DEMO_APP}>Open the live studio →</a></p>
  </section>
  <script is:inline src="/js/receipts.js"></script>
  <script is:inline define:vars={{ DEMO_APP, WAITLIST_URL }}>
    // DOM helpers — results are built with createElement/textContent, never innerHTML.
    function el(tag, className, text) {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined && text !== null) node.textContent = String(text);
      return node;
    }
    function demoButton(label) {
      const p = el('p');
      const a = el('a', 'btn btn-primary', label);
      a.href = DEMO_APP;
      p.appendChild(a);
      return p;
    }
    async function unlock(source) {
      const status = document.querySelector('#gate .form-status');
      const btn = document.getElementById('unlock');
      btn.disabled = true;
      let data;
      try {
        const res = await fetch(WAITLIST_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: document.getElementById('email').value,
            website: document.getElementById('website').value,
            source: source
          })
        });
        data = await res.json();
      } catch {
        data = { ok: false, error: 'Network error — try again.' };
      } finally {
        btn.disabled = false;
      }
      status.hidden = false;
      status.textContent = data.ok ? 'Unlocked — see the result panel.' : (data.error || 'Something went wrong.');
      return Boolean(data.ok);
    }
    let last = null;
    const result = document.getElementById('result');
    document.getElementById('run').onclick = function () {
      last = BluePainterTools.gradeSimpleReceipts({
        padding: document.getElementById('padding').value,
        background: document.getElementById('bg').value,
        ctaText: document.getElementById('cta').value,
        borderRadius: document.getElementById('radius').value,
        featureCount: document.getElementById('features').value
      });
      const list = el('ul');
      last.rules.forEach(function (r) {
        list.appendChild(el('li', r.valid ? 'ok' : 'bad', (r.valid ? '✓ ' : '✕ ') + r.title));
      });
      result.replaceChildren(el('div', 'score-big', last.score), el('p', '', 'Policy score'), list);
      document.getElementById('gate').hidden = false;
    };
    document.getElementById('unlock').onclick = async function () {
      if (!(await unlock('receipt-grader')) || !last || result.querySelector('[data-unlocked]')) return;
      const heading = el('h3', '', 'Suggested fixes');
      heading.setAttribute('data-unlocked', '');
      const list = el('ul');
      const fixes = last.rules.filter(function (r) { return r.fix !== null && r.fix !== undefined; });
      if (!fixes.length) list.appendChild(el('li', '', 'No fixes needed'));
      fixes.forEach(function (r) { list.appendChild(el('li', '', r.id + ' → ' + r.fix)); });
      result.append(heading, list, demoButton('Open in BluePainter'));
    };
  </script>
</BaseLayout>
