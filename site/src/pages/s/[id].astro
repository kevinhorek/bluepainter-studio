---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareCard from '../../components/ShareCard.astro';
import type { SharePayload } from '../../components/ShareCard.astro';
import { BRAND, SITE_URL } from '../../lib/constants';
import { DEMO_SHARE_CARDS } from '../../lib/share';

// Static sample cards. Real sessions are shared as /s#<payload> (see ./index.astro).
export function getStaticPaths() {
  return Object.entries(DEMO_SHARE_CARDS).map(([id, payload]) => ({ params: { id }, props: { payload } }));
}

interface Props {
  payload: SharePayload;
}

const { payload } = Astro.props;
const id = Astro.params.id;
const shareUrl = `${SITE_URL}/s/${id}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: `${BRAND.name} ${payload.label}`,
  description: `Sample card — score ${payload.score}, ${payload.nodes} nodes, ${payload.fixes} receipt fixes.`
};
---

<BaseLayout
  title={`${payload.label}: ${payload.score} — BluePainter`}
  description={`Sample BluePainter ${payload.label} card — score ${payload.score}.`}
  ogImage={`${SITE_URL}/og-share.png`}
  ogImageAlt="BluePainter design policy scorecard"
  noindex
  jsonLd={jsonLd}
>
  <section class="section">
    <ShareCard payload={payload} shareUrl={shareUrl} />
    <p class="muted share-note">Sample card with example numbers. Run a session in the Studio to share your own.</p>
  </section>
</BaseLayout>
