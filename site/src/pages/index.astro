---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEMO_APP, REPO_URL } from '../lib/constants';
---

<BaseLayout>
  <!-- ============ HERO ============ -->
  <section class="home-hero">
    <p class="eyebrow hero-in" style="--d:0ms">Repo-native visual development for React</p>
    <h1 class="hero-title hero-in" style="--d:80ms">
      Design, code, ship&nbsp;—<br />
      <span class="stroke-wrap">
        <span class="stroke-text">one surface.</span>
        <svg class="stroke" viewBox="0 0 520 90" preserveAspectRatio="none" aria-hidden="true">
          <path d="M8 58 C 70 30, 150 74, 236 46 S 400 26, 512 50" />
          <path class="stroke-2" d="M22 70 C 110 52, 210 82, 318 60 S 450 50, 500 66" />
        </svg>
      </span>
    </h1>
    <p class="hero-lead hero-in" style="--d:160ms">
      Drag it on the canvas or type it in the TSX — BluePainter patches the <em>same file</em> either way,
      keeps your comments and formatting, and flags design-policy issues before review does.
    </p>
    <div class="actions hero-actions hero-in" style="--d:240ms">
      <a class="btn btn-primary btn-lg" href={DEMO_APP}>Open the live studio <span aria-hidden="true">→</span></a>
      <a class="btn btn-ghost btn-lg" href="/pilot">Request a pilot</a>
    </div>
    <p class="hero-note hero-in" style="--d:300ms">Free during validation · No signup · Try it right here ↓</p>

    <!-- Live demo: a tiny real version of the product loop -->
    <div class="demo hero-in" style="--d:380ms" id="demo" data-demo>
      <div class="demo-chrome">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="demo-tab is-active">PricingCard.tsx</span>
        <span class="demo-sync"><span class="sync-dot"></span><span data-sync-label>in sync</span></span>
        <span class="demo-spacer"></span>
        <button type="button" class="demo-btn" data-action="break">Break it</button>
        <button type="button" class="demo-btn demo-btn-fix" data-action="fixall">Fix all</button>
      </div>

      <div class="demo-body">
        <!-- Canvas -->
        <div class="demo-canvas">
          <span class="pane-label">Canvas</span>
          <div class="pc" data-card>
            <span class="pc-select" aria-hidden="true"><b>PricingCard</b></span>
            <div class="pc-plan">Pro</div>
            <div class="pc-price">$29<small>/month</small></div>
            <ul>
              <li>Unlimited projects</li>
              <li>Priority support</li>
              <li>Custom domain</li>
            </ul>
            <button type="button" class="pc-cta" data-cta contenteditable="plaintext-only" spellcheck="false" aria-label="Button label — click to edit">Start free trial</button>
          </div>

          <div class="inspector">
            <label>
              <span>Padding <output data-out="padding">32</output></span>
              <input type="range" min="8" max="56" value="32" data-ctl="padding" aria-label="Padding" />
            </label>
            <label>
              <span>Radius <output data-out="radius">12</output></span>
              <input type="range" min="0" max="32" value="12" data-ctl="radius" aria-label="Corner radius" />
            </label>
            <div class="swatches" role="group" aria-label="Button colour">
              <button type="button" data-color="#2563eb" style="--c:#2563eb" aria-label="Blue"></button>
              <button type="button" data-color="#1e40af" style="--c:#1e40af" aria-label="Navy"></button>
              <button type="button" data-color="#7c3aed" style="--c:#7c3aed" aria-label="Violet"></button>
              <button type="button" data-color="#f59e0b" style="--c:#f59e0b" aria-label="Amber"></button>
              <button type="button" data-color="#cbd5e1" style="--c:#cbd5e1" aria-label="Pale grey"></button>
            </div>
          </div>
        </div>

        <!-- Code -->
        <div class="demo-code">
          <span class="pane-label">Code <em>— the values are editable too</em></span>
          <pre data-code aria-label="Generated TSX"></pre>
        </div>
      </div>

      <!-- Receipts -->
      <div class="demo-receipts">
        <div class="score" data-score-wrap>
          <svg viewBox="0 0 44 44" aria-hidden="true">
            <circle cx="22" cy="22" r="18" class="ring-bg" />
            <circle cx="22" cy="22" r="18" class="ring" data-ring />
          </svg>
          <strong data-score>100</strong>
        </div>
        <div class="receipt-copy">
          <b>Designer's Receipts</b>
          <span data-receipt-summary>All checks pass against team policy.</span>
        </div>
        <div class="pills" data-pills></div>
      </div>
    </div>
  </section>

  <!-- ============ STACK STRIP ============ -->
  <section class="strip" aria-label="Works with">
    <span>Works in your stack</span>
    <ul>
      <li>React</li><li>TSX</li><li>Vite</li><li>VS Code</li><li>Figma import</li><li>GitHub</li><li>Vercel</li><li>MCP</li>
    </ul>
  </section>

  <!-- ============ THE DIFF ============ -->
  <section class="section diff-section">
    <div class="diff-copy" data-reveal>
      <p class="eyebrow">Why it's different</p>
      <h2>The diff your reviewer actually wants.</h2>
      <p class="lead">
        Most visual tools regenerate the file. BluePainter parses your TSX into an AST and patches
        only the node you touched — so a padding tweak is a one-line diff, not a rewrite.
      </p>
      <ul class="checks">
        <li>Comments, imports and formatting survive every canvas edit</li>
        <li>Dynamic props like <code>{'{theme.primary}'}</code> are left alone</li>
        <li>Works on files already in your repo — no proprietary format</li>
      </ul>
    </div>
    <div class="diffs" data-reveal="120">
      <figure class="diff-card diff-bad">
        <figcaption><span class="tag tag-bad">Regenerate</span> 41 lines changed</figcaption>
        <pre><span class="del">- // Pro plan — keep in sync with billing</span>
<span class="del">- &lt;div id="card" style={'{{'} padding: 32,</span>
<span class="del">-   color: theme.primary {'}}'}&gt;</span>
<span class="add">+ &lt;div id="card" style={'{{'}"padding":24,</span>
<span class="add">+   "color":"#2563eb"{'}}'}&gt;</span>
<span class="del">-   &lt;h3 id="plan"&gt;Pro&lt;/h3&gt;</span>
<span class="add">+   &lt;h3 id="plan" style={'{{}}'}&gt;Pro&lt;/h3&gt;</span>
<span class="fade">  …38 more</span></pre>
      </figure>
      <figure class="diff-card diff-good">
        <figcaption><span class="tag tag-good">BluePainter</span> 1 line changed</figcaption>
        <pre>  // Pro plan — keep in sync with billing
<span class="del">- &lt;div id="card" style={'{{'} padding: 32,</span>
<span class="add">+ &lt;div id="card" style={'{{'} padding: 24,</span>
    color: theme.primary {'}}'}&gt;
    &lt;h3 id="plan"&gt;Pro&lt;/h3&gt;</pre>
      </figure>
    </div>
  </section>

  <!-- ============ BENTO ============ -->
  <section class="section">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Three surfaces, one source of truth</p>
      <h2>Everything a design–dev pair needs,<br />nothing that leaves the repo.</h2>
    </div>

    <div class="bento">
      <article class="tile tile-wide" data-reveal>
        <span class="badge">Sync</span>
        <h3>Canvas ↔ TSX, both directions</h3>
        <p class="muted">Select, drag, resize and retype on the canvas. Or edit the code. Each side updates the other in real time through one AST.</p>
        <div class="mini-sync" aria-hidden="true">
          <div class="mini-box"><i></i><i></i><i class="hl"></i></div>
          <div class="mini-arrows"><span>→</span><span>←</span></div>
          <div class="mini-code"><i></i><i class="hl"></i><i></i><i></i></div>
        </div>
      </article>

      <article class="tile" data-reveal="80">
        <span class="badge">Governance</span>
        <h3>Designer's Receipts</h3>
        <p class="muted">Contrast, spacing grid, corner scale, CTA copy and clutter — checked live against <em>your</em> team policy, each with a one-click fix.</p>
        <ul class="mini-receipts" aria-hidden="true">
          <li class="ok">✓ Contrast 5.2:1</li>
          <li class="warn">· Padding off 8px grid</li>
          <li class="ok">✓ Strong CTA copy</li>
        </ul>
      </article>

      <article class="tile" data-reveal="160">
        <span class="badge">Ship</span>
        <h3>Export &amp; deploy</h3>
        <p class="muted">Download a clean Vite project, push to GitHub, or deploy straight to Vercel.</p>
        <pre class="mini-term" aria-hidden="true"><span>$</span> export → my-app.zip
<span>$</span> push   → github.com/you/my-app
<span>$</span> deploy → my-app.vercel.app <b>✓</b></pre>
      </article>

      <article class="tile" data-reveal="80">
        <span class="badge">Editor</span>
        <h3>VS Code extension</h3>
        <p class="muted">Canvas preview, inspector and receipts beside the file you already have open. Edits write back to disk.</p>
      </article>

      <article class="tile" data-reveal="160">
        <span class="badge">Agents</span>
        <h3>MCP server</h3>
        <p class="muted">Let your coding agent grade a component against policy or analyse which JSX is canvas-syncable.</p>
        <a href="/knowledge/mcp">How it works →</a>
      </article>

      <article class="tile" data-reveal="240">
        <span class="badge">Import</span>
        <h3>Start from Figma</h3>
        <p class="muted">Bring a frame in as editable layers and real TSX, then keep going in code.</p>
      </article>
    </div>
  </section>

  <!-- ============ TOOLS ============ -->
  <section class="section">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Free tools</p>
      <h2>Kick the tyres in ten seconds.</h2>
      <p class="lead">The same receipt engine, no install, no account.</p>
    </div>
    <div class="grid-3">
      <a class="card tool-card" href="/tools/contrast-checker" data-reveal>
        <span class="badge">A11y</span>
        <h3>Contrast checker</h3>
        <p class="muted">WCAG ratio for any button colour, with the fix BluePainter would suggest.</p>
        <span class="go">Open tool →</span>
      </a>
      <a class="card tool-card" href="/tools/receipt-grader" data-reveal="80">
        <span class="badge">Policy</span>
        <h3>Receipt grader</h3>
        <p class="muted">Score spacing, contrast, CTA copy, radius and clutter in one pass.</p>
        <span class="go">Open tool →</span>
      </a>
      <a class="card tool-card" href="/tools/tsx-id-analyzer" data-reveal="160">
        <span class="badge">Sync</span>
        <h3>TSX id analyzer</h3>
        <p class="muted">Paste a component, see exactly which elements the canvas can map.</p>
        <span class="go">Open tool →</span>
      </a>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="section">
    <div class="cta-band" data-reveal>
      <div>
        <h2>Stop translating between design and code.</h2>
        <p>Open the studio in your browser, or bring your design–dev pair for a facilitated pilot on your own components.</p>
      </div>
      <div class="actions">
        <a class="btn btn-lg cta-white" href={DEMO_APP}>Open the live studio</a>
        <a class="btn btn-lg cta-outline" href="/pilot">Request a pilot</a>
        <a class="cta-link" href={REPO_URL}>View on GitHub ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .home-hero {
    max-width: var(--max);
    margin: 0 auto;
    padding: 84px 24px 40px;
    text-align: center;
  }
  .home-hero .eyebrow { justify-content: center; }
  .hero-title {
    font-size: clamp(2.5rem, 7vw, 5.2rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: 800;
    margin: 0 auto 30px;
  }
  .stroke-wrap { position: relative; display: inline-block; white-space: nowrap; }
  .stroke-text { position: relative; z-index: 1; }
  .stroke {
    position: absolute;
    left: -5%;
    right: -5%;
    bottom: -6%;
    width: 110%;
    height: 78%;
    z-index: 0;
    overflow: visible;
  }
  .stroke path {
    fill: none;
    stroke: var(--paint);
    stroke-width: 34;
    stroke-linecap: round;
    stroke-dasharray: 620;
    stroke-dashoffset: 620;
    opacity: 0.95;
    animation: paint 0.9s cubic-bezier(0.6, 0, 0.2, 1) 0.55s forwards;
    filter: drop-shadow(0 10px 30px rgba(47, 107, 255, 0.55));
  }
  .stroke .stroke-2 { stroke: #6d4dff; stroke-width: 14; opacity: 0.75; animation-delay: 0.85s; filter: none; }
  @keyframes paint { to { stroke-dashoffset: 0; } }

  .hero-lead {
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    color: var(--muted);
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .hero-lead em { color: var(--text); font-style: normal; font-weight: 600; }
  .hero-actions { justify-content: center; }
  .hero-note { font-family: var(--mono); font-size: 0.76rem; color: var(--faint); margin: 18px 0 0; letter-spacing: 0.02em; }

  /* Visible by default; the entrance only applies while the animation runs. */
  .hero-in { animation: heroIn 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms) backwards; }
  @keyframes heroIn { from { opacity: 0; transform: translateY(14px); } }

  /* ---------- Demo window ---------- */
  .demo {
    margin: 52px auto 0;
    max-width: 1040px;
    text-align: left;
    border-radius: 18px;
    border: 1px solid var(--border-strong);
    background: #0a101d;
    box-shadow:
      0 0 0 1px rgba(47, 107, 255, 0.18),
      0 40px 120px -20px rgba(47, 107, 255, 0.45),
      0 30px 60px -30px rgba(0, 0, 0, 0.8);
    overflow: hidden;
  }
  .demo-chrome {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.035);
    border-bottom: 1px solid var(--border);
    font-size: 0.8rem;
  }
  .dots { display: inline-flex; gap: 6px; }
  .dots i { width: 10px; height: 10px; border-radius: 50%; background: rgba(255, 255, 255, 0.14); }
  .demo-tab {
    font-family: var(--mono);
    padding: 5px 10px;
    border-radius: 7px;
    background: rgba(255, 255, 255, 0.07);
    color: #dbe4f5;
    font-size: 0.76rem;
  }
  .demo-sync { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-family: var(--mono); font-size: 0.72rem; }
  .sync-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.6); }
  .demo.is-syncing .sync-dot { animation: ping 0.6s ease-out; background: var(--paint-bright); }
  @keyframes ping { 0% { box-shadow: 0 0 0 0 rgba(91, 140, 255, 0.7); } 100% { box-shadow: 0 0 0 10px rgba(91, 140, 255, 0); } }
  .demo-spacer { flex: 1; }
  .demo-btn {
    font: inherit;
    font-size: 0.76rem;
    font-weight: 600;
    padding: 6px 11px;
    border-radius: 8px;
    border: 1px solid var(--border-strong);
    background: transparent;
    color: var(--text);
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s, border-color 0.15s;
  }
  .demo-btn:hover { background: rgba(255, 255, 255, 0.08); }
  .demo-btn-fix { background: var(--paint); border-color: transparent; color: #fff; }
  .demo-btn-fix:hover { background: var(--primary-hover); }

  .demo-body { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); }
  .pane-label {
    position: absolute;
    top: 12px;
    left: 14px;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .pane-label em { text-transform: none; letter-spacing: 0; font-style: normal; color: #6f85b3; }

  .demo-canvas {
    position: relative;
    padding: 46px 22px 18px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    background-color: #0d1424;
    background-image: radial-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    background-size: 18px 18px;
    border-right: 1px solid var(--border);
  }

  /* The component on the canvas (driven by CSS variables set from JS) */
  .pc {
    --pad: 32px;
    --rad: 12px;
    --btn: #2563eb;
    position: relative;
    width: min(100%, 280px);
    background: #fff;
    color: #0f172a;
    padding: var(--pad);
    border-radius: var(--rad);
    box-shadow: 0 24px 50px -18px rgba(0, 0, 0, 0.7);
    transition: padding 0.25s cubic-bezier(0.2, 0.7, 0.2, 1), border-radius 0.25s;
    font-family: var(--font);
  }
  .pc-select {
    position: absolute;
    inset: -5px;
    border: 1.5px solid var(--paint-bright);
    border-radius: calc(var(--rad) + 4px);
    pointer-events: none;
  }
  .pc-select b {
    position: absolute;
    top: -19px;
    left: -1.5px;
    font-family: var(--mono);
    font-size: 0.6rem;
    font-weight: 600;
    background: var(--paint-bright);
    color: #fff;
    padding: 2px 6px;
    border-radius: 4px 4px 4px 0;
  }
  .pc-select::after {
    content: "";
    position: absolute;
    right: -5px;
    bottom: -5px;
    width: 8px;
    height: 8px;
    background: #fff;
    border: 1.5px solid var(--paint-bright);
  }
  .pc-plan { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #64748b; }
  .pc-price { font-family: var(--display); font-size: 2.3rem; font-weight: 800; letter-spacing: -0.03em; margin: 2px 0 10px; }
  .pc-price small { font-family: var(--font); font-size: 0.85rem; font-weight: 500; color: #64748b; letter-spacing: 0; margin-left: 4px; }
  .pc ul { list-style: none; margin: 0 0 16px; padding: 0; font-size: 0.86rem; color: #475569; display: grid; gap: 6px; }
  .pc-cta {
    width: 100%;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 11px 12px;
    border: none;
    border-radius: 8px;
    background: var(--btn);
    color: #fff;
    cursor: text;
    transition: background 0.25s;
    outline-offset: 3px;
  }
  .pc-cta:focus { outline: 2px dashed var(--paint-bright); }

  .inspector {
    width: min(100%, 320px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 14px;
    padding: 12px 14px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border);
    font-size: 0.74rem;
    color: var(--muted);
  }
  .inspector label span { display: flex; justify-content: space-between; margin-bottom: 4px; }
  .inspector output { font-family: var(--mono); color: var(--text); }
  .inspector input[type="range"] { width: 100%; accent-color: var(--paint-bright); margin: 0; }
  .swatches { grid-column: 1 / -1; display: flex; gap: 8px; }
  .swatches button {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.18);
    background: var(--c);
    cursor: pointer;
    padding: 0;
    transition: transform 0.15s;
  }
  .swatches button:hover { transform: scale(1.12); }
  .swatches button[aria-pressed="true"] { border-color: #fff; box-shadow: 0 0 0 2px var(--paint-bright); }

  .demo-code { position: relative; padding: 46px 0 18px; min-width: 0; }
  .demo-code pre {
    margin: 0;
    font-size: clamp(0.7rem, 1.05vw, 0.82rem);
    line-height: 1.85;
    color: #b9c5dc;
    overflow-x: auto;
    counter-reset: ln;
  }
  .demo-code :global(.ln) {
    display: block;
    padding: 0 18px 0 0;
    white-space: pre;
    border-left: 2px solid transparent;
    transition: background 0.9s ease-out, border-color 0.9s ease-out;
  }
  .demo-code :global(.ln)::before {
    counter-increment: ln;
    content: counter(ln);
    display: inline-block;
    width: 2.6em;
    margin-right: 1em;
    text-align: right;
    color: #3e4a63;
  }
  .demo-code :global(.ln.flash) {
    background: rgba(47, 107, 255, 0.22);
    border-left-color: var(--paint-bright);
    transition: none;
  }
  .demo-code :global(.k) { color: #c792ea; }
  .demo-code :global(.t) { color: #7fb4ff; }
  .demo-code :global(.a) { color: #8ad6c6; }
  .demo-code :global(.s) { color: #f2c38b; }
  .demo-code :global(.c) { color: #5b6a85; font-style: italic; }
  .demo-code :global(input.tok) {
    font: inherit;
    color: #ffd18c;
    background: rgba(255, 209, 140, 0.1);
    border: none;
    border-bottom: 1px dashed rgba(255, 209, 140, 0.6);
    border-radius: 4px 4px 0 0;
    padding: 0 3px;
    margin: 0;
    height: 1.5em;
    outline: none;
  }
  .demo-code :global(input.tok:hover), .demo-code :global(input.tok:focus) { background: rgba(255, 209, 140, 0.22); border-bottom-style: solid; }
  .demo-code :global(input.tok.num) { color: #f78c6c; background: rgba(247, 140, 108, 0.12); border-bottom-color: rgba(247, 140, 108, 0.6); }

  .demo-receipts {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border-top: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.025);
    flex-wrap: wrap;
  }
  .score { position: relative; width: 44px; height: 44px; flex-shrink: 0; }
  .score svg { width: 44px; height: 44px; transform: rotate(-90deg); }
  .score circle { fill: none; stroke-width: 4; }
  .ring-bg { stroke: rgba(255, 255, 255, 0.1); }
  .ring { stroke: var(--ok); stroke-linecap: round; stroke-dasharray: 113.1; stroke-dashoffset: 0; transition: stroke-dashoffset 0.5s cubic-bezier(0.2, 0.7, 0.2, 1), stroke 0.3s; }
  .score strong { position: absolute; inset: 0; display: grid; place-items: center; font-family: var(--display); font-size: 0.86rem; }
  .receipt-copy { display: flex; flex-direction: column; font-size: 0.78rem; color: var(--muted); min-width: 170px; }
  .receipt-copy b { color: var(--text); font-size: 0.84rem; }
  .pills { display: flex; flex-wrap: wrap; gap: 8px; flex: 1; justify-content: flex-end; }
  .pills :global(.pill) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.74rem;
    padding: 5px 6px 5px 10px;
    border-radius: 999px;
    border: 1px solid rgba(52, 211, 153, 0.3);
    background: rgba(52, 211, 153, 0.08);
    color: #9be8cb;
    animation: pillIn 0.3s ease-out;
  }
  .pills :global(.pill.ok) { padding-right: 10px; }
  .pills :global(.pill.warn) { border-color: rgba(251, 191, 36, 0.4); background: rgba(251, 191, 36, 0.1); color: #fcd684; }
  .pills :global(.pill.bad) { border-color: rgba(248, 113, 113, 0.45); background: rgba(248, 113, 113, 0.12); color: #fca5a5; }
  .pills :global(.pill button) {
    font: inherit;
    font-size: 0.7rem;
    font-weight: 700;
    border: none;
    border-radius: 999px;
    padding: 3px 9px;
    cursor: pointer;
    background: #fff;
    color: #0b1220;
  }
  @keyframes pillIn { from { opacity: 0; transform: translateY(4px); } }

  /* ---------- Strip ---------- */
  .strip {
    max-width: var(--max);
    margin: 28px auto 0;
    padding: 18px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px 26px;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--faint);
  }
  .strip ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 22px; list-style: none; margin: 0; padding: 0; color: #a3b0c9; }

  /* ---------- Diff ---------- */
  .diff-section { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 56px; align-items: center; }
  .diff-copy h2, .section-head h2 { margin: 0 0 16px; }
  .section-head { margin-bottom: 36px; max-width: 760px; }
  .checks { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 12px; color: #c5cede; }
  .checks li { padding-left: 30px; position: relative; }
  .checks li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 1px;
    width: 20px;
    height: 20px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--paint-soft);
    color: var(--paint-bright);
    font-size: 0.7rem;
    font-weight: 800;
  }
  .checks code { background: rgba(255, 255, 255, 0.08); padding: 1px 6px; border-radius: 5px; font-size: 0.85em; }
  .diffs { display: grid; gap: 16px; }
  .diff-card { margin: 0; border-radius: 14px; border: 1px solid var(--border); background: #0a101d; overflow: hidden; }
  .diff-card figcaption {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    font-family: var(--mono);
    font-size: 0.74rem;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
  }
  .tag { padding: 3px 8px; border-radius: 6px; font-weight: 600; }
  .tag-bad { background: rgba(248, 113, 113, 0.14); color: #fca5a5; }
  .tag-good { background: rgba(52, 211, 153, 0.14); color: #86efc5; }
  .diff-card pre { margin: 0; padding: 12px 0; font-size: 0.76rem; line-height: 1.75; color: #94a3bd; overflow-x: auto; }
  .diff-card pre { padding-left: 14px; }
  .diff-card .del, .diff-card .add { display: inline-block; min-width: 100%; margin-left: -14px; padding-left: 14px; }
  .diff-card .del { background: rgba(248, 113, 113, 0.1); color: #fca5a5; }
  .diff-card .add { background: rgba(52, 211, 153, 0.1); color: #86efc5; }
  .diff-card .fade { color: #46526b; }
  .diff-bad { opacity: 0.72; transform: scale(0.97); transform-origin: right center; }
  .diff-good { border-color: rgba(91, 140, 255, 0.5); box-shadow: 0 24px 70px -24px rgba(47, 107, 255, 0.55); }

  /* ---------- Bento ---------- */
  .bento { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .tile {
    position: relative;
    overflow: hidden;
    padding: 26px;
    border-radius: 18px;
    border: 1px solid var(--border);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.012));
    transition: border-color 0.25s, transform 0.25s;
  }
  .tile::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(420px circle at var(--mx, 50%) var(--my, -20%), rgba(47, 107, 255, 0.2), transparent 60%);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .tile:hover { border-color: rgba(91, 140, 255, 0.45); transform: translateY(-2px); }
  .tile:hover::before { opacity: 1; }
  .tile > * { position: relative; }
  .tile h3 { margin: 0 0 8px; font-size: 1.25rem; }
  .tile p { margin: 0; font-size: 0.95rem; }
  .tile a { display: inline-block; margin-top: 14px; font-size: 0.88rem; font-weight: 600; }
  .tile-wide { grid-column: span 2; grid-row: span 2; display: flex; flex-direction: column; }
  .tile-wide .badge { align-self: flex-start; }
  .tile-wide h3 { font-size: 1.6rem; }
  .tile-wide p { max-width: 46ch; }

  .mini-sync { margin-top: auto; padding-top: 32px; display: grid; grid-template-columns: 1fr auto 1fr; gap: 18px; align-items: center; }
  .mini-box, .mini-code { border-radius: 14px; border: 1px solid var(--border); background: #0a101d; padding: 26px 22px; display: grid; gap: 14px; align-content: center; min-height: 250px; }
  .mini-box { background: #fff; }
  .mini-box i { height: 14px; border-radius: 4px; background: #e2e8f0; }
  .mini-box i:first-child { width: 45%; }
  .mini-box i.hl { height: 38px; border-radius: 7px; background: var(--paint); animation: pulseA 3.2s ease-in-out infinite; }
  .mini-code i { height: 11px; border-radius: 3px; background: rgba(255, 255, 255, 0.1); }
  .mini-code i:nth-child(1) { width: 60%; }
  .mini-code i:nth-child(3) { width: 80%; }
  .mini-code i:nth-child(4) { width: 40%; }
  .mini-code i.hl { background: var(--paint-bright); width: 72%; animation: pulseB 3.2s ease-in-out infinite; }
  .mini-arrows { display: grid; gap: 4px; font-family: var(--mono); color: var(--paint-bright); font-size: 1.1rem; }
  @keyframes pulseA { 0%, 100% { opacity: 1; } 45% { opacity: 0.45; transform: scaleX(0.9); } }
  @keyframes pulseB { 0%, 40%, 100% { opacity: 0.45; } 60% { opacity: 1; box-shadow: 0 0 18px rgba(91, 140, 255, 0.8); } }

  .mini-receipts { list-style: none; padding: 0; margin: 18px 0 0; display: grid; gap: 6px; font-family: var(--mono); font-size: 0.76rem; }
  .mini-receipts li { padding: 6px 10px; border-radius: 8px; background: rgba(255, 255, 255, 0.04); }
  .mini-term { margin: 18px 0 0; padding: 12px 14px; border-radius: 10px; background: #070b14; border: 1px solid var(--border); font-size: 0.74rem; line-height: 1.8; color: #a3b0c9; overflow-x: auto; }
  .mini-term span { color: var(--paint-bright); }
  .mini-term b { color: var(--ok); }

  .tool-card { display: flex; flex-direction: column; align-items: flex-start; color: inherit; }
  .tool-card .go { margin-top: auto; padding-top: 14px; font-size: 0.86rem; font-weight: 600; color: var(--paint-bright); }

  /* ---------- CTA band ---------- */
  .cta-band {
    position: relative;
    overflow: hidden;
    border-radius: 26px;
    padding: clamp(32px, 5vw, 60px);
    background:
      radial-gradient(600px 300px at 90% 0%, rgba(255, 255, 255, 0.22), transparent 60%),
      linear-gradient(120deg, #1d4ed8 0%, var(--paint) 45%, #6d4dff 100%);
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 32px;
    align-items: center;
    box-shadow: 0 40px 100px -30px rgba(47, 107, 255, 0.7);
  }
  .cta-band h2 { margin: 0 0 12px; color: #fff; font-size: clamp(1.7rem, 3.4vw, 2.6rem); }
  .cta-band p { margin: 0; color: rgba(255, 255, 255, 0.86); max-width: 46ch; }
  .cta-band .actions { margin: 0; justify-content: flex-end; align-items: center; }
  .cta-white { background: #fff; color: #0b1a44; box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25); }
  .cta-white:hover { color: #0b1a44; transform: translateY(-1px); }
  .cta-outline { border-color: rgba(255, 255, 255, 0.5); color: #fff; }
  .cta-outline:hover { background: rgba(255, 255, 255, 0.12); color: #fff; }
  .cta-link { color: rgba(255, 255, 255, 0.85); font-size: 0.88rem; font-weight: 600; width: 100%; text-align: right; }
  .cta-link:hover { color: #fff; }

  @media (max-width: 900px) {
    .home-hero { padding: 56px 18px 24px; }
    .demo-body { grid-template-columns: 1fr; }
    .demo-canvas { border-right: none; border-bottom: 1px solid var(--border); }
    .demo-sync, .dots { display: none; }
    .home-hero .eyebrow::before { display: none; }
    .demo-chrome { gap: 8px; }
    .pills { justify-content: flex-start; }
    .diff-section { grid-template-columns: 1fr; gap: 32px; }
    .diff-bad { transform: none; }
    .bento { grid-template-columns: 1fr; }
    .tile-wide { grid-column: auto; grid-row: auto; }
    .cta-band { grid-template-columns: 1fr; }
    .cta-band .actions { justify-content: flex-start; }
    .cta-link { text-align: left; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-in { animation: none; }
    .stroke path { stroke-dashoffset: 0; animation: none; }
  }
</style>

<script>
  // A small, honest version of the product loop: one state object drives the
  // canvas, the TSX and the receipts — edit any of the three.
  const root = document.querySelector<HTMLElement>('[data-demo]');
  if (root) {
    const GOOD = { padding: 32, radius: 12, color: '#2563eb', text: 'Start free trial' };
    const BROKEN = { padding: 34, radius: 13, color: '#cbd5e1', text: 'Submit' };
    const POLICY = { grid: 8, radiusGrid: 4, minContrast: 4.5, weak: ['submit', 'click here', 'send', 'button', 'ok', 'enter'], fixColor: '#1e40af', fixText: 'Start free trial' };
    const state = { ...GOOD };

    const card = root.querySelector<HTMLElement>('[data-card]')!;
    const cta = root.querySelector<HTMLElement>('[data-cta]')!;
    const codeEl = root.querySelector<HTMLElement>('[data-code]')!;
    const pillsEl = root.querySelector<HTMLElement>('[data-pills]')!;
    const scoreEl = root.querySelector<HTMLElement>('[data-score]')!;
    const ringEl = root.querySelector<SVGCircleElement>('[data-ring]')!;
    const summaryEl = root.querySelector<HTMLElement>('[data-receipt-summary]')!;
    const syncLabel = root.querySelector<HTMLElement>('[data-sync-label]')!;

    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    const tok = (key: string, value: string | number, num = false) =>
      `<input class="tok${num ? ' num' : ''}" data-tok="${key}" value="${esc(String(value))}" style="width:calc(${Math.max(String(value).length, 1)}ch + 6px)" spellcheck="false" aria-label="${key} in code"${num ? ' inputmode="numeric"' : ''} />`;

    const fit = (input: HTMLInputElement) => { input.style.width = `calc(${Math.max(input.value.length, 1)}ch + 6px)`; };

    // --- contrast (WCAG) ---
    const lum = (hex: string) => {
      const m = /^#?([0-9a-f]{6})$/i.exec(hex.trim());
      if (!m) return null;
      const [r, g, b] = [0, 2, 4].map((i) => {
        const c = parseInt(m[1].slice(i, i + 2), 16) / 255;
        return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
      });
      return 0.2126 * r + 0.7152 * g + 0.0722 * b;
    };
    const contrastOnWhiteText = (hex: string) => {
      const l = lum(hex);
      return l === null ? null : Math.round((1.05 / (l + 0.05)) * 100) / 100;
    };

    type Receipt = { id: string; ok: boolean; level: 'ok' | 'warn' | 'bad'; label: string; fix?: () => void };
    function receipts(): Receipt[] {
      const ratio = contrastOnWhiteText(state.color);
      const nearestPad = Math.max(POLICY.grid, Math.round(state.padding / POLICY.grid) * POLICY.grid);
      const nearestRad = Math.round(state.radius / POLICY.radiusGrid) * POLICY.radiusGrid;
      const weak = POLICY.weak.includes(state.text.trim().toLowerCase());
      const list: Receipt[] = [];
      const padOk = state.padding % POLICY.grid === 0;
      list.push(padOk
        ? { id: 'spacing', ok: true, level: 'ok', label: `Padding on ${POLICY.grid}px grid` }
        : { id: 'spacing', ok: false, level: 'warn', label: `Padding ${state.padding}px off grid`, fix: () => set({ padding: nearestPad }, 'receipt') });
      const radOk = state.radius % POLICY.radiusGrid === 0;
      list.push(radOk
        ? { id: 'radius', ok: true, level: 'ok', label: `Radius on ${POLICY.radiusGrid}px scale` }
        : { id: 'radius', ok: false, level: 'warn', label: `Radius ${state.radius}px is odd`, fix: () => set({ radius: nearestRad }, 'receipt') });
      if (ratio !== null) {
        list.push(ratio >= POLICY.minContrast
          ? { id: 'contrast', ok: true, level: 'ok', label: `Contrast ${ratio}:1` }
          : { id: 'contrast', ok: false, level: 'bad', label: `Contrast ${ratio}:1 fails AA`, fix: () => set({ color: POLICY.fixColor }, 'receipt') });
      }
      list.push(!weak
        ? { id: 'copy', ok: true, level: 'ok', label: 'Strong CTA copy' }
        : { id: 'copy', ok: false, level: 'warn', label: `“${state.text.trim()}” is weak CTA copy`, fix: () => set({ text: POLICY.fixText }, 'receipt') });
      return list;
    }

    // --- render ---
    let prevLines: string[] = [];
    function codeLines() {
      return [
        `<span class="k">export function</span> <span class="t">PricingCard</span>({ theme }) {`,
        `  <span class="k">return</span> (`,
        `    <span class="c">{/* Pro plan — keep in sync with billing */}</span>`,
        `    <span class="t">&lt;div</span> <span class="a">id</span>=<span class="s">"card"</span> <span class="a">style</span>={{ <span class="a">padding</span>: ${tok('padding', state.padding, true)}, <span class="a">borderRadius</span>: ${tok('radius', state.radius, true)} }}<span class="t">&gt;</span>`,
        `      <span class="t">&lt;h3</span> <span class="a">id</span>=<span class="s">"plan"</span><span class="t">&gt;</span>Pro<span class="t">&lt;/h3&gt;</span>`,
        `      <span class="t">&lt;span</span> <span class="a">id</span>=<span class="s">"price"</span> <span class="a">style</span>={{ <span class="a">color</span>: theme.ink }}<span class="t">&gt;</span>$29<span class="t">&lt;/span&gt;</span>`,
        `      <span class="t">&lt;button</span> <span class="a">id</span>=<span class="s">"cta"</span> <span class="a">style</span>={{ <span class="a">background</span>: <span class="s">'</span>${tok('color', state.color)}<span class="s">'</span> }}<span class="t">&gt;</span>`,
        `        ${tok('text', state.text)}`,
        `      <span class="t">&lt;/button&gt;</span>`,
        `    <span class="t">&lt;/div&gt;</span>`,
        `  );`,
        `}`
      ];
    }

    function render(source: string) {
      // canvas
      card.style.setProperty('--pad', `${state.padding}px`);
      card.style.setProperty('--rad', `${state.radius}px`);
      card.style.setProperty('--btn', state.color);
      // readable label on light buttons, exactly what the contrast receipt is about
      if (source !== 'canvas-text' && cta.textContent !== state.text) cta.textContent = state.text;
      root!.querySelectorAll<HTMLInputElement>('[data-ctl]').forEach((el) => {
        const key = el.dataset.ctl as 'padding' | 'radius';
        if (document.activeElement !== el) el.value = String(state[key]);
      });
      root!.querySelectorAll<HTMLElement>('[data-out]').forEach((el) => { el.textContent = String(state[el.dataset.out as 'padding' | 'radius']); });
      root!.querySelectorAll<HTMLElement>('[data-color]').forEach((el) => el.setAttribute('aria-pressed', String(el.dataset.color!.toLowerCase() === state.color.toLowerCase())));

      // code — update tokens in place when the user is typing in one, otherwise re-render and flash changed lines
      const lines = codeLines();
      const active = document.activeElement as HTMLInputElement | null;
      const typingInCode = active && active.classList?.contains('tok') && codeEl.contains(active);
      if (typingInCode && codeEl.children.length === lines.length) {
        codeEl.querySelectorAll<HTMLInputElement>('input.tok').forEach((input) => {
          if (input === active) { fit(input); return; }
          const v = String(state[input.dataset.tok as keyof typeof state]);
          input.value = v;
          fit(input);
        });
      } else {
        codeEl.innerHTML = lines.map((l) => `<span class="ln">${l}</span>`).join('');
        if (prevLines.length) {
          Array.from(codeEl.children).forEach((el, i) => {
            if (lines[i] !== prevLines[i]) {
              el.classList.add('flash');
              requestAnimationFrame(() => requestAnimationFrame(() => el.classList.remove('flash')));
            }
          });
        }
      }
      prevLines = lines;

      // receipts
      const list = receipts();
      const failing = list.filter((r) => !r.ok);
      const score = Math.max(0, 100 - failing.reduce((sum, r) => sum + (r.level === 'bad' ? 30 : 12), 0));
      scoreEl.textContent = String(score);
      ringEl.style.strokeDashoffset = String(113.1 * (1 - score / 100));
      ringEl.style.stroke = score >= 90 ? 'var(--ok)' : score >= 70 ? 'var(--warn)' : 'var(--bad)';
      summaryEl.textContent = failing.length
        ? `${failing.length} issue${failing.length > 1 ? 's' : ''} against team policy — one click each.`
        : 'All checks pass against team policy.';
      pillsEl.innerHTML = '';
      (failing.length ? failing : list.slice(0, 3)).forEach((r) => {
        const pill = document.createElement('span');
        pill.className = `pill ${r.level}`;
        pill.textContent = `${r.ok ? '✓ ' : ''}${r.label}`;
        if (r.fix) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = 'Fix';
          btn.addEventListener('click', () => { stopAuto(); r.fix!(); });
          pill.appendChild(btn);
        }
        pillsEl.appendChild(pill);
      });

      // sync pulse
      if (source !== 'init') {
        syncLabel.textContent = source.startsWith('code') ? 'code → canvas' : source === 'receipt' ? 'receipt → both' : 'canvas → code';
        root!.classList.remove('is-syncing');
        void root!.offsetWidth;
        root!.classList.add('is-syncing');
        clearTimeout(syncTimer);
        syncTimer = window.setTimeout(() => { syncLabel.textContent = 'in sync'; root!.classList.remove('is-syncing'); }, 900);
      }
    }
    let syncTimer = 0;

    function set(patch: Partial<typeof state>, source: string) {
      Object.assign(state, patch);
      render(source);
    }

    // --- canvas controls ---
    root.querySelectorAll<HTMLInputElement>('[data-ctl]').forEach((el) => {
      el.addEventListener('input', () => { stopAuto(); set({ [el.dataset.ctl!]: Number(el.value) }, 'canvas'); });
    });
    root.querySelectorAll<HTMLElement>('[data-color]').forEach((el) => {
      el.addEventListener('click', () => { stopAuto(); set({ color: el.dataset.color! }, 'canvas'); });
    });
    cta.addEventListener('input', () => { stopAuto(); set({ text: (cta.textContent || '').replace(/\s+/g, ' ') }, 'canvas-text'); });
    cta.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); cta.blur(); } });
    cta.addEventListener('click', (e) => e.preventDefault());

    // --- code tokens ---
    codeEl.addEventListener('input', (e) => {
      const input = e.target as HTMLInputElement;
      if (!input.classList?.contains('tok')) return;
      stopAuto();
      const key = input.dataset.tok!;
      if (key === 'padding' || key === 'radius') {
        const n = parseInt(input.value, 10);
        if (!Number.isFinite(n)) { fit(input); return; }
        set({ [key]: Math.min(key === 'padding' ? 56 : 32, Math.max(0, n)) }, 'code');
      } else if (key === 'color') {
        fit(input);
        if (/^#[0-9a-f]{6}$/i.test(input.value.trim())) set({ color: input.value.trim() }, 'code');
      } else {
        set({ text: input.value }, 'code');
      }
    });
    codeEl.addEventListener('focusout', () => setTimeout(() => { if (!codeEl.contains(document.activeElement)) render('init'); }, 0));
    codeEl.addEventListener('keydown', (e) => { if (e.key === 'Enter') (e.target as HTMLElement).blur(); });

    // --- header buttons ---
    root.querySelector('[data-action="break"]')!.addEventListener('click', () => { stopAuto(); set({ ...BROKEN }, 'canvas'); });
    root.querySelector('[data-action="fixall"]')!.addEventListener('click', () => {
      stopAuto();
      receipts().filter((r) => r.fix).forEach((r) => r.fix!());
      if (!receipts().some((r) => !r.ok)) return;
    });

    // --- gentle autoplay until the visitor touches anything ---
    let autoTimers: number[] = [];
    let autoStopped = false;
    function stopAuto() {
      autoStopped = true;
      autoTimers.forEach(clearTimeout);
      autoTimers = [];
    }
    function runAuto() {
      if (autoStopped) return;
      const steps: Array<[number, () => void]> = [
        [2600, () => set({ padding: 34 }, 'canvas')],
        [4200, () => set({ color: '#cbd5e1' }, 'canvas')],
        [5800, () => set({ text: 'Submit' }, 'code')],
        [8200, () => set({ color: POLICY.fixColor }, 'receipt')],
        [9400, () => set({ padding: 32 }, 'receipt')],
        [10600, () => set({ text: POLICY.fixText }, 'receipt')],
        [13200, () => set({ ...GOOD }, 'canvas')],
        [15000, runAuto]
      ];
      autoTimers = steps.map(([ms, fn]) => window.setTimeout(() => { if (!autoStopped) fn(); }, ms));
    }
    root.addEventListener('pointerdown', stopAuto);
    root.addEventListener('focusin', stopAuto);

    render('init');
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) runAuto();
  }

  // Cursor-following glow on bento tiles
  document.querySelectorAll<HTMLElement>('.tile').forEach((tile) => {
    tile.addEventListener('pointermove', (e) => {
      const r = tile.getBoundingClientRect();
      tile.style.setProperty('--mx', `${e.clientX - r.left}px`);
      tile.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });
</script>
