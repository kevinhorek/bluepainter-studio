---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEMO_APP, WAITLIST_URL } from '../lib/constants';
---

<BaseLayout
  title="Request a BluePainter Pilot"
  description="Request a facilitated BluePainter validation pilot — scorecard, session export, priority feedback."
>
  <section class="section">
    <div class="page-head" data-reveal>
      <p class="eyebrow">Pilot</p>
      <h1>Request a facilitated pilot</h1>
      <p class="lead">
        Tell us about your team. We schedule about eight pilots per wave — a 30–45 minute guided session on your own
        components. Meanwhile, the <a href={DEMO_APP}>free demo</a> is open to everyone.
      </p>
    </div>

    <form class="card form-stack stack-lg" style="max-width:520px" id="pilot-form" data-waitlist-url={WAITLIST_URL} data-reveal="80">
      <label for="name">Name</label>
      <input id="name" name="name" required autocomplete="name" placeholder="Alex Designer" />

      <label for="email">Work email</label>
      <input id="email" name="email" type="email" required autocomplete="email" placeholder="alex@company.com" />

      <label for="company">Company / team</label>
      <input id="company" name="company" autocomplete="organization" placeholder="Acme Design Systems" />

      <label for="role">Role</label>
      <select id="role" name="role">
        <option>Designer</option>
        <option>Frontend engineer</option>
        <option>Design engineer</option>
        <option>Engineering manager</option>
        <option>Other</option>
      </select>

      <label for="message">Why BluePainter? (optional)</label>
      <textarea id="message" name="message" placeholder="We lose spacing tokens on Figma handoff…"></textarea>

      <input type="hidden" name="source" value="pilot" />
      <span class="hp" aria-hidden="true">
        <label for="pilot-website">Website (leave this empty)</label>
        <input id="pilot-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </span>
      <button type="submit" class="btn btn-primary" style="margin-top:20px;width:100%">Request a pilot</button>
      <p class="form-status muted" hidden role="status"></p>
      <p class="muted" style="font-size:0.8rem;margin:14px 0 0">We only use this to contact you about a pilot. See <a href="/privacy">privacy</a>.</p>
    </form>
  </section>

  <script>
    const form = document.getElementById('pilot-form');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.querySelector('.form-status');
      const fd = new FormData(form);
      const endpoint = form.getAttribute('data-waitlist-url') || '/api/waitlist';
      const submitBtn = form.querySelector('button[type="submit"]');
      if (submitBtn) submitBtn.disabled = true;
      let data;
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(fd))
        });
        data = await res.json();
      } catch {
        data = { ok: false, error: 'Network error — please try again.' };
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
      status.hidden = false;
      status.textContent = data.ok
        ? 'Request received. We will email you when a seat opens.'
        : (data.error || 'Something went wrong.');
      if (data.ok) form.reset();
    });
  </script>
</BaseLayout>
