{
  "name": "bluepainter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "workspaces": [
    "packages/*",
    "extension"
  ],
  "scripts": {
    "dev": "vite",
    "dev:full": "vercel dev",
    "build": "vite build",
    "lint": "eslint .",
    "test:ast": "node scripts/test-ast-sync.mjs",
    "preview": "vite preview",
    "deploy:vercel": "npm run build && npx vercel --prod",
    "deploy:netlify": "npm run build && npx netlify deploy --prod --dir=dist",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "site:guides": "node scripts/generate-guides.mjs",
    "mcp:start": "npm --prefix mcp start",
    "repurpose": "node scripts/repurpose.mjs",
    "verify:export": "node --import ./scripts/esm-resolve.mjs ./scripts/verify-export.mjs",
    "test:features": "node --import ./scripts/esm-resolve.mjs ./scripts/feature-tests.mjs",
    "test:ast": "node scripts/test-ast-sync.mjs && node scripts/test-ast-sync-advanced.mjs",
    "check:receipts": "node scripts/check-receipts.mjs extension/test-fixtures/PricingCard.tsx",
    "desktop": "concurrently -k -s first -n vite,desktop \"vite --host 127.0.0.1 --port 5173\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "desktop:prod": "npm run build && cross-env BLUEPAINTER_DESKTOP_PROD=1 electron ."
  },
  "dependencies": {
    "@babel/parser": "^8.0.0",
    "@babel/traverse": "^8.0.0",
    "@babel/types": "^8.0.0",
    "@vercel/analytics": "^2.0.1",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recast": "^0.23.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^37.2.6",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "happy-dom": "^20.10.6",
    "vite": "^8.0.12",
    "wait-on": "^8.0.4"
  }
}
