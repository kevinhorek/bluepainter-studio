# BluePainter environment variables — copy to .env.local for `npm run dev:full` (vercel dev),
# or set them in the Vercel project settings. Never commit real values.
# Everything is optional for local Studio development; see the notes for production.

# ============================================================================
# SUPABASE AUTHENTICATION & PROJECTS (optional locally)
# ============================================================================
# With these set, the Studio asks users to sign in and saves projects to Supabase.
# Without them it runs signed-out and keeps work in the browser only.
# https://haafbckedfzkwgetodxg.supabase.co

VITE_SUPABASE_URL=https://haafbckedfzkwgetodxg.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_w1cL-8EywkD5qeQF3oVp9Q_fSQaQIzV

# Legacy support (prefer publishable key)
# VITE_SUPABASE_ANON_KEY=<your-anon-key-here>

# ============================================================================
# AUDIT LOG BACKEND (Optional)
# ============================================================================
# The audit log backend persists learning loop events (receipt fixes, dismissals)
# to a team database for analytics and compliance.
#
# WITHOUT these variables:
#   - App works normally in "soft-fail" mode
#   - Events buffer to localStorage only
#   - No team-wide audit data
#
# WITH these variables:
#   - Events persist to Postgres for team audit trail
#   - 90-day retention policy
#   - Query via /api/audit-log/query
#
# See: docs/AUDIT_BACKEND.md for full setup guide

# PostgreSQL connection string (REQUIRED for production audit logging)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
#
# Examples:
#   Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
#   Vercel Postgres: postgresql://[USER]:[PASSWORD]@[HOST]/[DATABASE]?sslmode=require
#   Local dev: postgresql://localhost:5432/bluepainter_dev
#
# DATABASE_URL=

# Audit backend API URL (OPTIONAL - defaults to /api/audit-log)
# Only set this if you're using a custom backend deployment or separate audit service.
# For most Vercel deployments, the default is correct.
#
# Examples:
#   Production: https://audit.example.com/api/audit-log
#   Staging: https://staging-api.example.com/audit-log
#   Local (default): /api/audit-log
#
# VITE_AUDIT_API_URL=/api/audit-log

# ---------- api/ (Vercel serverless functions) ----------

# Server-side OpenAI key for /api/generate. Without it, callers must send their own key (X-OpenAI-Key).
OPENAI_API_KEY=
# OpenAI chat model used by /api/generate and scripts/repurpose.mjs (default: gpt-4o-mini).
OPENAI_MODEL=

# Extra browser origins allowed to call the API, comma-separated (e.g. a custom domain).
# Always allowed: the two bluepainter-*.vercel.app production sites, bluepainter* preview URLs, localhost, and the deployment's own host.
ALLOWED_ORIGINS=

# Upstash Redis REST endpoint: durable waitlist/feedback lists and cross-instance rate limiting.
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST token (pair with the URL above; both must be set).
UPSTASH_REDIS_REST_TOKEN=

# Webhook that receives each waitlist signup as a JSON POST (Zapier, Make, Slack workflow, ...).
# Production needs this or Upstash, otherwise /api/waitlist returns 503.
WAITLIST_WEBHOOK=
# Legacy fallback for WAITLIST_WEBHOOK (used only when WAITLIST_WEBHOOK is empty).
RESEND_WEBHOOK=
# Webhook that receives in-app feedback as a JSON POST; falls back to WAITLIST_WEBHOOK when empty.
FEEDBACK_WEBHOOK=

# Set by Vercel automatically (production | preview | development) — do not set by hand.
# In production, /api/waitlist and /api/feedback refuse to accept entries they cannot store durably.
# VERCEL_ENV=

# ---------- mcp/ (stdio MCP server; set in the MCP client's env block) ----------

# Marketing site base URL used in links the MCP server returns (default: https://bluepainter-launch.vercel.app).
BLUEPAINTER_SITE_URL=
# Base URL of the Studio deployment whose /api the MCP server calls (default: the hosted Studio).
BLUEPAINTER_API_BASE=
# Full waitlist endpoint override (default: <studio>/api/waitlist).
BLUEPAINTER_WAITLIST_URL=
# Timeout in milliseconds for the MCP server's HTTP calls (default: 15000).
BLUEPAINTER_TIMEOUT_MS=
# Figma personal access token. Used by /api/figma-import when the request carries no token
# (team deployments), and by the MCP figma import tool when no `token` argument is passed.
FIGMA_TOKEN=
