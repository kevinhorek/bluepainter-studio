# BluePainter environment variables — copy to .env.local for `npm run dev:full` (vercel dev),
# or set them in the Vercel project settings. Never commit real values.
# Everything is optional for local Studio development; see the notes for production.

# ---------- api/ (Vercel serverless functions) ----------

# Server-side OpenAI key for /api/generate. Without it, callers must send their own key (X-OpenAI-Key).
OPENAI_API_KEY=
# OpenAI chat model used by /api/generate and scripts/repurpose.mjs (default: gpt-4o-mini).
OPENAI_MODEL=

# Extra browser origins allowed to call the API, comma-separated (e.g. a custom domain).
# Always allowed: the two bluepainter-*.vercel.app production sites, bluepainter* preview URLs, localhost, and the deployment's own host.
ALLOWED_ORIGINS=

# Upstash Redis REST endpoint: durable waitlist/feedback lists and cross-instance rate limiting.
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST token (pair with the URL above; both must be set).
UPSTASH_REDIS_REST_TOKEN=

# Webhook that receives each waitlist signup as a JSON POST (Zapier, Make, Slack workflow, ...).
# Production needs this or Upstash, otherwise /api/waitlist returns 503.
WAITLIST_WEBHOOK=
# Legacy fallback for WAITLIST_WEBHOOK (used only when WAITLIST_WEBHOOK is empty).
RESEND_WEBHOOK=
# Webhook that receives in-app feedback as a JSON POST; falls back to WAITLIST_WEBHOOK when empty.
FEEDBACK_WEBHOOK=

# Set by Vercel automatically (production | preview | development) — do not set by hand.
# In production, /api/waitlist and /api/feedback refuse to accept entries they cannot store durably.
# VERCEL_ENV=

# ---------- mcp/ (stdio MCP server; set in the MCP client's env block) ----------

# Marketing site base URL used in links the MCP server returns (default: https://bluepainter-launch.vercel.app).
BLUEPAINTER_SITE_URL=
# Base URL of the Studio deployment whose /api the MCP server calls (default: the hosted Studio).
BLUEPAINTER_API_BASE=
# Full waitlist endpoint override (default: <studio>/api/waitlist).
BLUEPAINTER_WAITLIST_URL=
# Timeout in milliseconds for the MCP server's HTTP calls (default: 15000).
BLUEPAINTER_TIMEOUT_MS=
# Figma personal access token used by the MCP figma import tool when no `token` argument is passed.
FIGMA_TOKEN=
